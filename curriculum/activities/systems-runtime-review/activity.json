  "quality": {
    "referenceFiles": {
      "main.cpp": "#include <cstdio>\n#include <fstream>\n#include <iostream>\n#include <iterator>\n#include <string>\n#include <sys/wait.h>\n#include <thread>\n#include <unistd.h>\nint inspect(){std::ifstream input(\"review.txt\",std::ios::binary);std::string data((std::istreambuf_iterator<char>(input)),{});return static_cast<int>(data.size());}int main(){std::thread writer([]{std::ofstream(\"review.txt\")<<\"review\";});writer.join();pid_t child=fork();if(child==0)_exit(inspect());int status{};waitpid(child,&status,0);std::remove(\"review.txt\");std::cout<<\"bytes=\"<<WEXITSTATUS(status)<<'\\n';}\n"
    },
    "mutations": [
      {
        "id": "constant-status",

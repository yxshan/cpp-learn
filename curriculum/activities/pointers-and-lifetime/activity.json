  "content": {
    "format": "markdown",
    "path": "activities/pointers-and-lifetime/lesson.md"
  },
  "workspace": {
    "editablePaths": ["main.cpp"],
    "starterFiles": {
      "main.cpp": "#include <iostream>\nint main(){ int value{}; std::cin>>value; int* observer = nullptr; /* TODO */ }\n"
    }
  },
  "judge": {
    "version": 1,
    "expectedStdout": "42\n",
    "timeoutMs": 2000,
    "publicTests": [
      {
        "name": "increment",
        "stdin": "41\n",
        "expectedStdout": "42\n"
      }
    ],

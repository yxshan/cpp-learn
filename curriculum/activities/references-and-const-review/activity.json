    "starterFiles": {
      "main.cpp": "#include <iostream>\nint larger(const int& a,const int& b){ /* recall */ }\nint main(){ int a{},b{};std::cin>>a>>b;std::cout<<larger(a,b)<<'\\n';}\n"
    }
  },
  "judge": {
    "version": 1,

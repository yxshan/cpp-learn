{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-generation.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "draftId", "contextDigest", "section"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "draftId": { "$ref": "#/$defs/id" },
    "contextDigest": { "$ref": "#/$defs/digest" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "markdown", "claims"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "markdown": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "factGroupIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "factGroupIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}

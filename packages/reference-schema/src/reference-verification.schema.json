{
  "$id": "https://cpp-learn.local/schemas/reference-verification.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "compilerFingerprint",
    "examples"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "compilerFingerprint": { "type": "string", "minLength": 1 },
    "examples": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entryId",
          "exampleId",
          "sourceDigest",
          "standard",
          "verification"
        ],
        "properties": {
          "entryId": { "$ref": "#/$defs/id" },
          "exampleId": { "$ref": "#/$defs/id" },
          "sourceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "standard": { "$ref": "#/$defs/standard" },
          "verification": { "enum": ["verified", "unsupported"] }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "standard": {
      "enum": [
        "c++98",
        "c++03",
        "c++11",
        "c++14",
        "c++17",
        "c++20",
        "c++23",
        "c++26-draft"
      ]
    }
  }
}

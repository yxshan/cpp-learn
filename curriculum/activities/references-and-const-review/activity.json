      },
      {
        "id": "read-only-contract",
        "title": "保持只读契约",
        "kind": "concept",
        "content": "const 阻止函数通过引用修改调用者对象。"
      },
      {
        "id": "complete-solution",
        "title": "查看完整答案",
        "kind": "solution",
        "content": "return a > b ? a : b;"
      }
    ],
    "reflections": [
      {
        "id": "const-benefit",
        "prompt": "const int& 向调用者表达了什么保证？",
        "required": true
      }
    ],
    "reviewIds": [],
    "reviewOf": "references-and-const",
    "teacherRubric": {
      "id": "const-contract-rubric",
      "prompt": "回答应指出函数借用对象但承诺不通过该引用修改它。"
    }
  },
  "quality": {
    "referenceFiles": {
      "main.cpp": "#include <iostream>\nint larger(const int& a,const int& b){ return a>b?a:b; } int main(){int a{},b{};std::cin>>a>>b;std::cout<<larger(a,b)<<'\\n';}\n"
    },
    "mutations": [
      {
        "id": "always-first",
        "files": {
          "main.cpp": "#include <iostream>\nint larger(const int&a,const int&){return a;} int main(){int a{},b{};std::cin>>a>>b;std::cout<<larger(a,b)<<'\\n';}\n"
        },
        "expectedVerdict": "public_failure"
      }
    ],

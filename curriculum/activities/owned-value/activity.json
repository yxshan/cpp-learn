    "path": "activities/owned-value/lesson.md"
  },
  "workspace": {
    "editablePaths": ["main.cpp"],
    "starterFiles": {
      "main.cpp": "#include <iostream>\n#include <memory>\n#include <utility>\nint main(){int n{};std::cin>>n;/* own, move, print double */}\n"
    }
  },
  "judge": {
    "version": 1,
    "expectedStdout": "12\n",
    "timeoutMs": 2000,

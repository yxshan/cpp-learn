    "starterFiles": {
      "main.cpp": "#include <iostream>\n#include <string>\n#include <unordered_map>\nint main(){std::unordered_map<std::string,int> index;int count{};std::cin>>count;while(count--){std::string op,key;std::cin>>op>>key;if(op==\"set\"){int value{};std::cin>>value;index.emplace(key,value);}else if(op==\"erase\"){index.erase(key);}else if(op==\"get\"){auto found=index.find(key);std::cout<<(found==index.end()?\"missing\":std::to_string(found->second))<<'\\n';}}}\n"
    }
  },

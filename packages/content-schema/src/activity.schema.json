{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-learn.local/schemas/activity.v1.json",
  "title": "C++ Learn Activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "title",
    "estimatedMinutes",
    "conceptIds",
    "prerequisiteIds",
    "objectives",
    "victoryConditions",
    "sources",
    "content",
    "workspace",
    "judge",
    "evidencePolicy",
    "learning",
    "quality"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": {
      "enum": ["lesson", "exercise", "review", "project-milestone"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 480 },
    "conceptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "prerequisiteIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "victoryConditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/source" }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path"],
      "properties": {
        "format": { "enum": ["markdown"] },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.md$"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editablePaths", "starterFiles"],
      "properties": {
        "persistenceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "editablePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        },
        "starterFiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" },
          "propertyNames": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "expectedStdout", "timeoutMs"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "expectedStdout": { "type": "string", "maxLength": 65536 },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "publicTests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publicTest" }
        },
        "privateTests": {
          "type": "array",
          "items": { "$ref": "#/$defs/privateTest" }
        },
        "propertyTests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/propertyTest" }
        },
        "performanceCheck": { "$ref": "#/$defs/performanceCheck" },
        "buildProfile": { "$ref": "#/$defs/buildProfile" },
        "sanitizers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["address", "undefined"] }
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatedPass",
        "demonstratedRequiresReflection",
        "demonstratedRequiresIndependent",
        "reviewAfterDays"
      ],
      "properties": {
        "automatedPass": { "type": "boolean" },
        "demonstratedRequiresReflection": { "type": "boolean" },
        "demonstratedRequiresIndependent": { "type": "boolean" },
        "reviewAfterDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "teacherReviewRequired": { "type": "boolean" }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hints", "reflections", "reviewIds", "teacherRubric"],
      "properties": {
        "hints": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hint" }
        },
        "reflections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reflection" }
        },
        "reviewIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "reviewOf": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "teacherRubric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "prompt"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceFiles",
        "mutations",
        "interactiveBlocks",
        "printFallback"
      ],
      "properties": {
        "referenceFiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" },
          "propertyNames": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mutation" }
        },
        "interactiveBlocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/interactiveBlock" }
        },
        "printFallback": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "url"],
      "properties": {
        "kind": { "enum": ["primary", "reference"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 2000
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "files", "expectedVerdict"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" },
          "propertyNames": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        },
        "expectedVerdict": {
          "enum": [
            "compile_error",
            "runtime_error",
            "public_failure",
            "timeout",
            "output_limit",
            "private_failure",
            "property_failure",
            "performance_failure",
            "sanitizer_failure"
          ]
        }
      }
    },
    "interactiveBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "fallback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": {
          "enum": [
            "code-compare",
            "memory-visualization",
            "lifetime-timeline",
            "container-visualization",
            "algorithm-trace",
            "network-flow",
            "quiz",
            "exercise",
            "reflection"
          ]
        },
        "fallback": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "publicTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stdin", "expectedStdout"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "stdin": { "type": "string", "maxLength": 65536 },
        "expectedStdout": { "type": "string", "maxLength": 65536 }
      }
    },
    "privateTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stdin", "expectedStdout", "failureCategory"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "stdin": { "type": "string", "maxLength": 65536 },
        "expectedStdout": { "type": "string", "maxLength": 65536 },
        "failureCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "propertyTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "seed",
        "cases",
        "generator",
        "oracle",
        "failureCategory"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "cases": { "type": "integer", "minimum": 1, "maximum": 100 },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minLength",
            "maxLength",
            "minValue",
            "maxValue"
          ],
          "properties": {
            "kind": { "const": "integer-vector" },
            "minLength": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "maxLength": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "minValue": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "maxValue": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          }
        },
        "oracle": { "const": "sort-ascending" },
        "failureCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "performanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baselineStdin",
        "scaledStdin",
        "repetitions",
        "maxMedianRatio",
        "failureCategory"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "baselineStdin": { "type": "string", "maxLength": 65536 },
        "scaledStdin": { "type": "string", "maxLength": 65536 },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 9 },
        "maxMedianRatio": { "type": "number", "minimum": 1, "maximum": 100 },
        "failureCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "buildProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "direct" },
            "threadSupport": { "type": "boolean" },
            "libraries": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["sqlite3"] }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "testTarget", "ctest"],
          "properties": {
            "kind": { "const": "cmake" },
            "target": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.+-]+$",
              "maxLength": 120
            },
            "testTarget": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.+-]+$",
              "maxLength": 120
            },
            "ctest": { "type": "boolean" }
          }
        }
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["nudge", "concept", "solution"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" }
      }
    }
  }
}

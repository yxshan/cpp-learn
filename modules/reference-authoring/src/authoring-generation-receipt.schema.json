{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-generation-receipt.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "draftId",
    "appliedRevision",
    "contextDigest",
    "generation",
    "review",
    "appliedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "draftId": { "$ref": "#/$defs/id" },
    "appliedRevision": { "type": "integer", "minimum": 2 },
    "contextDigest": { "$ref": "#/$defs/digest" },
    "orchestration": { "$ref": "#/$defs/orchestration" },
    "generation": {
      "$ref": "https://cpp-learn.local/schemas/reference-authoring-generation.v1.json"
    },
    "review": {
      "$ref": "https://cpp-learn.local/schemas/reference-authoring-generated-review.v1.json"
    },
    "appliedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "planDigest", "stepId"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "runId": { "$ref": "#/$defs/id" },
        "planDigest": { "$ref": "#/$defs/digest" },
        "stepId": { "$ref": "#/$defs/id" }
      }
    }
  }
}

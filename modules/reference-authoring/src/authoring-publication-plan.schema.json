{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-publication-plan.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "draftId", "expectedRevision", "mode", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "draftId": { "$ref": "#/$defs/id" },
    "expectedRevision": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["dry_run", "apply"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}

  "learning": {
    "hints": [
      {
        "id": "create-owner",
        "title": "创建所有者",
        "kind": "nudge",
        "content": "先 make_unique<int>(n)。"
      },
      {
        "id": "move-owner",
        "title": "移动后使用目标",
        "kind": "concept",
        "content": "std::move 转移所有权，新变量负责释放对象。"
      },
      {
        "id": "complete-solution",
        "title": "查看完整答案",
        "kind": "solution",
        "content": "auto a=std::make_unique<int>(n);auto b=std::move(a);std::cout<<*b*2<<'\\n';"
      }
    ],
    "reflections": [
      {
        "id": "single-delete",
        "prompt": "唯一所有权如何避免重复释放？",
        "required": true
      }
    ],
    "reviewIds": ["copy-move-ownership-review"],
    "teacherRubric": {
      "id": "single-delete-rubric",
      "prompt": "回答应说明任一时刻只有一个所有者负责析构。"
    }
  },
  "quality": {
    "referenceFiles": {
      "main.cpp": "#include <iostream>\n#include <memory>\n#include <utility>\nint main(){int n{};std::cin>>n;auto a=std::make_unique<int>(n);auto b=std::move(a);std::cout<<*b*2<<'\\n';}\n"
    },
    "mutations": [
      {
        "id": "copy-owner",
        "files": {

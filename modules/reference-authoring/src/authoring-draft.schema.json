{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-draft.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "draftId",
    "revision",
    "state",
    "profile",
    "target",
    "affectedEntryIds",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "draftId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["draft", "ready_for_review", "checked"] },
    "profile": { "enum": ["callable", "entity", "header", "navigation"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "kind", "slug", "title"],
      "properties": {
        "entryId": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/entryKind" },
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "affectedEntryIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
    },
    "entryKind": {
      "enum": [
        "landing",
        "header",
        "type",
        "object",
        "function",
        "member",
        "concept",
        "guide"
      ]
    }
  }
}

{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-summary-generation-receipt.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "draftId",
    "appliedRevision",
    "contextDigest",
    "generation",
    "review",
    "appliedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "draftId": { "$ref": "#/$defs/id" },
    "appliedRevision": { "type": "integer", "minimum": 2 },
    "contextDigest": { "$ref": "#/$defs/digest" },
    "orchestration": {
      "$ref": "https://cpp-learn.local/schemas/reference-authoring-generation-orchestration.v1.json"
    },
    "generation": {
      "$ref": "https://cpp-learn.local/schemas/reference-authoring-summary-generation.v1.json"
    },
    "review": {
      "$ref": "https://cpp-learn.local/schemas/reference-authoring-generated-review.v1.json"
    },
    "appliedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

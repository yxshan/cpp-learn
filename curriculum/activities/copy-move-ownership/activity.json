        "id": "make-unique",
        "title": "使用工厂函数",
        "kind": "nudge",
        "content": "std::make_unique<int>(value) 创建并返回唯一所有者。"
      },
      {
        "id": "dereference-owner",
        "title": "读取被拥有对象",
        "kind": "concept",
        "content": "unique_ptr 支持 * 解引用，但离开作用域会自动释放对象。"
      },
      {
        "id": "complete-solution",
        "title": "查看完整答案",
        "kind": "solution",
        "content": "auto owned=std::make_unique<int>(value); std::cout<<*owned<<'\\n';"
      }
    ],
    "reflections": [
      {
        "id": "move-not-copy",
        "prompt": "为什么 unique_ptr 可以移动但不能复制？",
        "required": true
      }
    ],
    "reviewIds": ["copy-move-ownership-review"],
    "teacherRubric": {
      "id": "unique-owner-rubric",
      "prompt": "回答应指出复制会产生两个唯一所有者，而移动只转移所有权。"
    }

  "objectives": ["在延迟任务中同时恢复文件、线程和子进程的生命周期责任。"],
  "victoryConditions": ["写线程结束后子进程读取 6 字节，父进程等待并清理。"],
  "sources": [
    {
      "kind": "primary",
      "title": "cppreference: thread support library",
      "url": "https://en.cppreference.com/w/cpp/thread"
    },
    {
      "kind": "reference",

{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-batch-run.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "members"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batchId": { "$ref": "#/$defs/id" },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dependsOn", "run"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "run": {
          "$ref": "https://cpp-learn.local/schemas/reference-authoring-run.v1.json"
        }
      }
    }
  }
}

      "main.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\nint main(){std::vector<int> values(3);for(int& v:values)std::cin>>v;/* sort and print */}\n"
    }
  },
  "judge": {
    "version": 1,
    "expectedStdout": "1 2 3\n",

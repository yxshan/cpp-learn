      },
      {
        "id": "read-all-bytes",
        "title": "读取完整文件",
        "kind": "concept",
        "content": "用流迭代器构造字符串，再把长度放入子进程退出状态。"
      },
      {
        "id": "complete-solution",
        "title": "查看完整答案",
        "kind": "solution",
        "content": "inspect 打开 review.txt，读取全部字符并返回 size；保留 writer 作用域、waitpid 与 remove。"
      }
    ],
    "reflections": [
      {
        "id": "cleanup-order",
        "prompt": "解释 writer join、fork、waitpid 和 remove 的顺序为何不能随意交换。",
        "required": true
      }
    ],
    "reviewIds": [],

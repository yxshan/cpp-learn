{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-generation-orchestration.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "planDigest",
    "stepId",
    "factGroupIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "stepId": { "$ref": "#/$defs/id" },
    "factGroupIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

      },
      {
        "id": "range-loop",
        "title": "遍历排序结果",
        "kind": "concept",
        "content": "范围 for 逐个读取 vector 元素。"
      },
      {
        "id": "complete-solution",
        "title": "查看完整答案",
        "kind": "solution",
        "content": "std::sort(values.begin(),values.end()); for(int v:values) std::cout<<v<<' ';"
      }
    ],
    "reflections": [
      {
        "id": "algorithm-separation",

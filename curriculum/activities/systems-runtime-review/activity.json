  "content": {
    "format": "markdown",
    "path": "activities/systems-runtime-review/lesson.md"
  },
  "workspace": {
    "editablePaths": ["main.cpp"],
    "starterFiles": {
      "main.cpp": "#include <cstdio>\n#include <fstream>\n#include <iostream>\n#include <iterator>\n#include <string>\n#include <sys/wait.h>\n#include <thread>\n#include <unistd.h>\nint inspect(){/* recall file read */return 0;}int main(){std::thread writer([]{std::ofstream(\"review.txt\")<<\"review\";});writer.join();pid_t child=fork();if(child==0)_exit(inspect());int status{};waitpid(child,&status,0);std::remove(\"review.txt\");std::cout<<\"bytes=\"<<WEXITSTATUS(status)<<'\\n';}\n"
    }
  },
  "judge": {
    "version": 1,
    "expectedStdout": "bytes=6\n",
    "timeoutMs": 3000,
    "buildProfile": { "kind": "direct", "threadSupport": true },
    "publicTests": [
      { "name": "resource review", "stdin": "", "expectedStdout": "bytes=6\n" }
    ],
    "privateTests": [
      {
        "name": "resource lifecycle verification",
        "stdin": "",
        "expectedStdout": "bytes=6\n",
        "failureCategory": "resource-lifecycle"
      }
    ]
  },
  "evidencePolicy": {

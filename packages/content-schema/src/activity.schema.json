{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-learn.local/schemas/activity.v1.json",
  "title": "C++ Learn Activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "title",
    "estimatedMinutes",
    "conceptIds",
    "prerequisiteIds",
    "content",
    "evidencePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": {
      "enum": ["lesson", "exercise", "review", "project-milestone"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 480 },
    "conceptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "prerequisiteIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path"],
      "properties": {
        "format": { "enum": ["markdown"] },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.md$"
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatedPass"],
      "properties": {
        "automatedPass": { "type": "boolean" }
      }
    }
  }
}

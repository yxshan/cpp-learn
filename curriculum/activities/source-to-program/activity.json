          "main.cpp": "#include <iostream>\n\nint main() {\n    std::cout << \"Hello, Cpp!\\n\";\n    return 0;\n}\n"
        },
        "expectedVerdict": "public_failure"
      }
    ],
    "interactiveBlocks": [
      {
        "id": "build-pipeline",

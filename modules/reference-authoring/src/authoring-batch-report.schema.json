{
  "$id": "https://cpp-learn.local/schemas/reference-authoring-batch-report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "draftIds",
    "drafts",
    "status",
    "entries",
    "readyEntries",
    "examples",
    "cache",
    "findings",
    "timing",
    "quality",
    "targets",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batchId": { "$ref": "#/$defs/id" },
    "draftIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "drafts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draftId",
          "draftRevision",
          "inputDigest",
          "status",
          "examples"
        ],
        "properties": {
          "draftId": { "$ref": "#/$defs/id" },
          "draftRevision": { "type": "integer", "minimum": 1 },
          "inputDigest": { "$ref": "#/$defs/digest" },
          "status": { "enum": ["not_checked", "blocked", "ready"] },
          "examples": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "status": { "enum": ["meets-target", "needs-attention"] },
    "entries": { "type": "integer", "minimum": 1, "maximum": 5 },
    "readyEntries": { "type": "integer", "minimum": 0, "maximum": 5 },
    "examples": { "type": "integer", "minimum": 0 },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hits", "misses", "notChecked", "hitRate"],
      "properties": {
        "hits": { "type": "integer", "minimum": 0 },
        "misses": { "type": "integer", "minimum": 0 },
        "notChecked": { "type": "integer", "minimum": 0 },
        "hitRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "warning", "highRisk", "hardByCategory"],
      "properties": {
        "hard": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "highRisk": { "type": "integer", "minimum": 0 },
        "hardByCategory": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorActiveMinutes",
        "machineMinutes",
        "fullGateMinutes",
        "baselineAuthorActiveMinutes",
        "baselineEntries",
        "activeMinutesPerEntry",
        "baselineActiveMinutesPerEntry"
      ],
      "properties": {
        "authorActiveMinutes": { "type": "number", "minimum": 0 },
        "machineMinutes": { "type": "number", "minimum": 0 },
        "fullGateMinutes": { "type": "number", "minimum": 0 },
        "baselineAuthorActiveMinutes": { "type": "number", "minimum": 0 },
        "baselineEntries": { "type": "integer", "minimum": 1 },
        "activeMinutesPerEntry": { "type": "number", "minimum": 0 },
        "baselineActiveMinutesPerEntry": { "type": "number", "minimum": 0 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prePublicationCorrections",
        "postPublicationCorrections",
        "baselinePostPublicationCorrections",
        "postPublicationCorrectionRates",
        "baselinePostPublicationCorrectionRates",
        "highRiskClaimsReviewed",
        "flakyReruns"
      ],
      "properties": {
        "prePublicationCorrections": { "$ref": "#/$defs/corrections" },
        "postPublicationCorrections": { "$ref": "#/$defs/corrections" },
        "baselinePostPublicationCorrections": { "$ref": "#/$defs/corrections" },
        "postPublicationCorrectionRates": { "$ref": "#/$defs/rates" },
        "baselinePostPublicationCorrectionRates": { "$ref": "#/$defs/rates" },
        "highRiskClaimsReviewed": { "type": "integer", "minimum": 0 },
        "flakyReruns": { "type": "integer", "minimum": 0 }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiveEntryBatch",
        "activeMinutesWithinTarget",
        "throughputImproved",
        "noFactualDefectRegression",
        "noExampleDefectRegression",
        "noEscapedCorrectionRegression",
        "allHighRiskClaimsReviewed",
        "noFlakyReruns"
      ],
      "properties": {
        "fiveEntryBatch": { "type": "boolean" },
        "activeMinutesWithinTarget": { "type": "boolean" },
        "throughputImproved": { "type": "boolean" },
        "noFactualDefectRegression": { "type": "boolean" },
        "noExampleDefectRegression": { "type": "boolean" },
        "noEscapedCorrectionRegression": { "type": "boolean" },
        "allHighRiskClaimsReviewed": { "type": "boolean" },
        "noFlakyReruns": { "type": "boolean" }
      }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "corrections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factual", "example"],
      "properties": {
        "factual": { "type": "integer", "minimum": 0 },
        "example": { "type": "integer", "minimum": 0 }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factual", "example"],
      "properties": {
        "factual": { "type": "number", "minimum": 0 },
        "example": { "type": "number", "minimum": 0 }
      }
    }
  }
}
